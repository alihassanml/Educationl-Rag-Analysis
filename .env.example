# Settings for "docker compose up". Copy this file to ".env" (same folder) and fill in the three
# values marked REQUIRED. Never share or commit the real .env file.

# REQUIRED. Signs login sessions. Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# REQUIRED. Encrypts every uploaded file. Generate: python3 -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
# Keep a private backup of this value: without it, uploaded files cannot be read again.
FILE_ENCRYPTION_KEY=

# REQUIRED for answers and quizzes. Free key from https://console.groq.com
GROQ_API_KEY=

# Optional
GROQ_MODEL=openai/gpt-oss-120b
POSTGRES_PASSWORD=edurag
# Use http://localhost:3000 locally. In production, your site's public address.
CORS_ORIGINS=http://localhost:3000
# Set to true once the site is served over HTTPS
COOKIE_SECURE=false
