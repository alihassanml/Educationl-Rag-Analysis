# Copy to .env and adjust. Never commit the real .env file.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/edurag
CORS_ORIGINS=http://localhost:3000
# Redis for the background worker: brew install redis && brew services start redis
REDIS_URL=redis://localhost:6379/0
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
# Set true when served over HTTPS
COOKIE_SECURE=false

# false: uploads are indexed by the worker (.venv/bin/arq app.workers.settings.WorkerSettings).
# true: indexed inside the request, so no Redis or worker is needed (small setups, tests).
PROCESS_DOCUMENTS_INLINE=false

UPLOAD_DIR=uploads
MAX_UPLOAD_MB=20

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Topic extraction when a document becomes ready (outline, then headings, then the LLM)
TOPICS_MIN_PER_DOCUMENT=2
TOPICS_MAX_PER_DOCUMENT=12
TOPICS_LLM_SAMPLE_CHUNKS=12
TOPICS_LLM_FALLBACK=true

# Automatic difficulty: percent correct that moves a topic up or down one level
DIFFICULTY_UP_FROM=80
DIFFICULTY_DOWN_BELOW=50
SUPPORT_AFTER_FAILED_ATTEMPTS=2

# Diagnostic test length (1-2 questions per topic, at most this many in total)
DIAGNOSTIC_MAX_QUESTIONS=15
# Teacher dashboard: class-wide topic accuracy appears once this many students have practised it
CLASS_MIN_STUDENTS_FOR_AGGREGATES=3

# Light mode: wrong answers in a row, or quizzes in a row below the percent, start a lighter step
# Teacher style: how many passages of the teacher's material are read
TEACHER_STYLE_SAMPLE_CHUNKS=16

# Exam predictor
EXAM_MIN_PAPERS=2
EXAM_MATCH_MIN_SIMILARITY=0.5
EXAM_WEIGHT_FREQUENCY=0.5
EXAM_WEIGHT_RECENCY=0.3
EXAM_WEIGHT_MARKS=0.2
EXAM_HIGH_FROM=70
EXAM_MEDIUM_FROM=40
EXAM_EVIDENCE_PER_TOPIC=8
EXAM_PAPER_BATCH_CHARS=14000
EXAM_PAPER_MAX_BATCHES=6

MOOD_WRONG_STREAK=3
MOOD_LOW_SCORE_PERCENT=40
MOOD_LOW_SCORE_ATTEMPTS=2
CONFIDENCE_QUIZ_QUESTIONS=3
CONFIDENCE_PASS_CORRECT=2

# Groq: get a key at https://console.groq.com, then pick a model ID that your key can use.
# List available models with: .venv/bin/python -m app.scripts.list_groq_models
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Optional: low, medium or high for gpt-oss models (lower is faster)
GROQ_REASONING_EFFORT=low
